
\RequirePackage{ifluatex}
\ifluatex
\else
  \PackageError{mark2tex}{LuaTeX is required for this package!}{}
\fi
\ProvidesPackage{mark2tex}[2026/08/06 v0.2.0 Markdown-like fragments for LuaLaTeX]

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=mark2tex,prefix=marktotex@}
\DeclareStringOption{citation}
\DeclareStringOption{paren-citation}
\DeclareStringOption{save-dir}
\DeclareStringOption{header}
\DeclareBoolOption[false]{verbose}
\ProcessKeyvalOptions*
\ifmarktotex@verbose
  \def\marktotex@verbosevalue{true}
\else
  \def\marktotex@verbosevalue{false}
\fi

\RequirePackage[normalem]{ulem}
\RequirePackage{luacode}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{booktabs}


\begin{luacode*}
  local mark2tex_path = kpse.find_file("mark2tex.lua", "lua") or kpse.find_file("mark2tex.lua")
  if not mark2tex_path then
    tex.error("mark2tex.lua not found", { "Install the Mark2TeX Lua files where Kpathsea can find them." })
    return
  end

  local mark2tex_dir = mark2tex_path:match("^(.*)[/\\][^/\\]-$")
  if mark2tex_dir then
    package.path = mark2tex_dir .. "/?.lua;" .. mark2tex_dir .. "/?/init.lua;"
      .. mark2tex_dir .. "/src/?.lua;" .. mark2tex_dir .. "/src/?/init.lua;"
      .. package.path
    package.preload["mark2tex.nodes"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/nodes.lua")
    end
    package.preload["mark2tex.default_config"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/default_config.lua")
    end
    package.preload["mark2tex.fileutils"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/fileutils.lua")
    end
    package.preload["mark2tex.parse_blocks"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/parse_blocks.lua")
    end
    package.preload["mark2tex.math"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/math.lua")
    end
    package.preload["mark2tex.parse_inlines"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/parse_inlines.lua")
    end
    package.preload["mark2tex.parse"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/parse.lua")
    end
    package.preload["mark2tex.write"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/write.lua")
    end
    package.preload["mark2tex.core"] = function()
      return dofile(mark2tex_dir .. "/src/mark2tex/core.lua")
    end
  end

  local mark2tex = dofile(mark2tex_path)
  local cfg = {}
  local includeonly_paths = nil
  cfg.verbose = token.get_macro("marktotex@verbosevalue") == "true"

  -- Read option macros as data, without interpolating them into Lua source.
  for option, key in pairs({
    citation = "citation",
    ["paren-citation"] = "paren_citation",
    ["save-dir"] = "save_dir",
    header = "header",
  }) do
    local value = token.get_macro("marktotex@" .. option)
    if value and value ~= "" then
      cfg[key] = value
    end
  end

  if cfg.header then
    local headings = {}
    for heading in (cfg.header .. ","):gmatch("(.-),") do
      heading = heading:match("^%s*(.-)%s*$")
      if heading == "" then
        tex.error("Invalid mark2tex header option", { "Provide a comma-separated list of command names without empty entries." })
        return
      end
      headings[#headings + 1] = heading
    end
    cfg.header = headings
  end

  local function strip_tex_extension(path)
    return path:gsub("%.tex$", "")
  end

  local function tex_escape_path(path)
    return path:gsub("\\", "/")
  end

  local function trim(value)
    return value:match("^%s*(.-)%s*$")
  end

  function mark2tex_includeonly(paths)
    includeonly_paths = {}
    local output_paths = {}

    for path in paths:gmatch("[^,]+") do
      path = trim(path)
      if path ~= "" then
        includeonly_paths[path] = true
        output_paths[#output_paths + 1] = strip_tex_extension(
          tex_escape_path(mark2tex.get_output_path(path, cfg))
        )
      end
    end

    tex.sprint("\\includeonly{" .. table.concat(output_paths, ",") .. "}")
  end

  function mark2tex_input(path, include_mode)
    if include_mode and includeonly_paths and not includeonly_paths[path] then
      local output_path = tex_escape_path(mark2tex.get_output_path(path, cfg))
      tex.sprint("\\include{" .. strip_tex_extension(output_path) .. "}")
      return
    end

    local output_path, err = mark2tex.convert(path, cfg)
    if not output_path then
      tex.error("Mark2TeX failed to convert " .. path, { err or "unknown error" })
      return
    end

    output_path = tex_escape_path(output_path)
    if include_mode then
      tex.sprint("\\include{" .. strip_tex_extension(output_path) .. "}")
    else
      tex.sprint("\\input{" .. output_path .. "}")
    end
  end
\end{luacode*}

\newcommand{\mdinput}[1]{
  \luaexec{mark2tex_input("#1", false)}
}
\newcommand{\mdinclude}[1]{
  \luaexec{mark2tex_input("#1", true)}
}
\newcommand{\mdincludeonly}[1]{
  \luaexec{mark2tex_includeonly("#1")}
}
